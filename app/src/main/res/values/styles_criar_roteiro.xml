<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Rótulo principal da tela "Criar novo roteiro"
        (Nome do roteiro, Descrição, Selecione os dias, Tags, Orçamento).

        CORREÇÃO: layout_width e layout_height são obrigatórios em toda View.
        Como os TextView do layout usam apenas style="..." (sem declarar
        largura/altura), as medidas precisam vir daqui. Sem elas o Android
        lança InflateException ao abrir a tela e o app fecha.
    -->
    <style name="SalCityCriarRotulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#083572</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- Rótulo menor (Início / Fim). Mesma correção de medidas. -->
    <style name="SalCityCriarRotuloMenor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#083572</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>