<?xml version="1.0" encoding="utf-8"?>
<!-- SalCity: filtros de busca, sem configurações de criação de roteiro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp">
        <ImageButton android:id="@+id/btnVoltarFiltros" android:layout_width="48dp"
            android:layout_height="48dp" android:src="@drawable/ic_filtro_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="Filtros" android:textColor="#07336E" android:textSize="27sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/btnLimparFiltros" android:layout_width="wrap_content"
            android:layout_height="48dp" android:gravity="center"
            android:text="Limpar filtros" android:textColor="#087BF1"
            android:textSize="15sp" android:paddingHorizontal="5dp"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:paddingBottom="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:layout_marginBottom="22dp"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:text="Refine sua busca e encontre os roteiros ideais para o seu perfil."
                android:textSize="17sp" android:textColor="#334766" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp"
                android:background="@drawable/bg_sc_filter_card">
                <TextView android:id="@+id/tituloTemas" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="◇  Interesses / Temas  ⌄"
                    android:textColor="#07336E" android:textSize="21sp" android:textStyle="bold"
                    android:paddingBottom="12dp" />
                <LinearLayout android:id="@+id/grupoTemas" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical"
                android:padding="14dp" android:background="@drawable/bg_sc_filter_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⌖  Localização  ⌄" android:textColor="#07336E"
                    android:textSize="21sp" android:textStyle="bold" android:paddingBottom="10dp" />
                <Spinner android:id="@+id/spinnerLocalizacao" android:layout_width="match_parent"
                    android:layout_height="52dp" android:background="@drawable/bg_sc_filter_chip_off"
                    android:paddingStart="14dp" android:paddingEnd="12dp"
                    android:contentDescription="Selecionar localização" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical"
                android:padding="14dp" android:background="@drawable/bg_sc_filter_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="▣  Meio de transporte  ⌄" android:textColor="#07336E"
                    android:textSize="21sp" android:textStyle="bold" android:paddingBottom="12dp" />
                <LinearLayout android:id="@+id/grupoTransportes" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical"
                android:padding="14dp" android:background="@drawable/bg_sc_filter_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="▤  Faixa de orçamento (por pessoa)  ⌄"
                    android:textColor="#07336E" android:textSize="19sp" android:textStyle="bold"
                    android:paddingBottom="12dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Valor mínimo" android:textSize="13sp" android:textColor="#50718D" />
                <SeekBar android:id="@+id/seekMinOrcamento" android:layout_width="match_parent"
                    android:layout_height="40dp" android:max="500" android:progress="50"
                    android:progressTint="#FFBE08" android:thumbTint="#FFBE08" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Valor máximo" android:textSize="13sp" android:textColor="#50718D" />
                <SeekBar android:id="@+id/seekMaxOrcamento" android:layout_width="match_parent"
                    android:layout_height="40dp" android:max="500" android:progress="200"
                    android:progressTint="#FFBE08" android:thumbTint="#FFBE08" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/txtMinOrcamento" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="R$ 50" android:textColor="#07336E" android:textSize="17sp" />
                    <TextView android:id="@+id/txtMaxOrcamento" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="end" android:text="R$ 200" android:textColor="#07336E"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnAplicarFiltros" android:layout_width="match_parent"
        android:layout_height="62dp" android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp" android:background="@drawable/bg_filtro_button"
        android:backgroundTint="@null" android:text="Aplicar filtros"
        android:textAllCaps="false" android:textColor="#07336E"
        android:textStyle="bold" android:textSize="21sp" />
</LinearLayout>
