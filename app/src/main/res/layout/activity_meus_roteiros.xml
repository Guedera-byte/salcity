<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF" android:fitsSystemWindows="true">

    <!-- O conteúdo rola em celulares menores; a faixa decorativa permanece no rodapé. -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="18dp" android:paddingBottom="98dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageButton android:id="@+id/btnVoltarMeusRoteiros"
                    android:layout_width="46dp" android:layout_height="48dp"
                    android:src="@drawable/ic_meus_voltar"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="Meus roteiros"
                    android:textColor="#082F70" android:textStyle="bold" android:textSize="30sp" />
            </LinearLayout>
            <Button android:id="@+id/btnNovoRoteiro" android:layout_width="match_parent"
                android:layout_height="64dp" android:layout_marginTop="34dp"
                android:text="＋  Criar novo roteiro" android:textAllCaps="false"
                android:textSize="20sp" android:textStyle="bold" android:textColor="#082F70"
                android:background="@drawable/bg_meus_amarelo" />
            <TextView android:id="@+id/txtQuantidadeRoteiros"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:layout_marginBottom="20dp"
                android:text="Meus roteiros (0)" android:textColor="#082F70"
                android:textStyle="bold" android:textSize="23sp" />
            <LinearLayout android:id="@+id/estadoVazioRoteiros"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:padding="24dp" android:background="@drawable/bg_meus_cartao">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Você ainda não criou roteiros" android:gravity="center"
                    android:textSize="19sp" android:textStyle="bold" android:textColor="#082F70" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:gravity="center"
                    android:text="Toque em Criar novo roteiro para planejar seu próximo passeio."
                    android:textSize="15sp" android:textColor="#55708D" />
                <Button android:id="@+id/btnCriarPrimeiroRoteiro"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="18dp" android:text="Criar meu primeiro roteiro"
                    android:textAllCaps="false" android:textStyle="bold"
                    android:textColor="#082F70" android:background="@drawable/bg_meus_amarelo" />
            </LinearLayout>
            <LinearLayout android:id="@+id/listaMeusRoteiros"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <!-- Onda inferior da identidade SalCity. -->
    <ImageView android:layout_width="match_parent" android:layout_height="62dp"
        android:layout_gravity="bottom" android:src="@drawable/bg_meus_ondas_inferiores"
        android:scaleType="fitXY" android:contentDescription="@null" />
</FrameLayout>
