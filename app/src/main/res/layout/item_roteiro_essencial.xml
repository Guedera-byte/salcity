<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="18dp" android:orientation="vertical"
    android:background="@drawable/bg_roteiros_card" android:clipToOutline="true" android:elevation="4dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="188dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/foto_pelourinho" android:scaleType="centerCrop"
            android:contentDescription="Imagem ilustrativa do roteiro Salvador Essencial"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="12dp" android:background="@drawable/bg_roteiros_destaque" android:padding="10dp" android:text="Mais popular" android:textStyle="bold" android:textColor="#0B3264" android:textSize="14sp"/>
        <ImageButton android:id="@+id/btnFavorito" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="top|end" android:layout_margin="12dp"
            android:padding="11dp" android:background="@drawable/bg_roteiros_favorito"
            android:src="@drawable/ic_roteiros_coracao" android:contentDescription="Favoritar Salvador Essencial"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Salvador Essencial" android:textColor="#0B3264" android:textStyle="bold" android:textSize="25sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="◷  1 dia" android:textColor="#153A68" android:textSize="15sp"/>
            <TextView android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content"
                android:text="⌖  5 locais" android:textColor="#153A68" android:textSize="15sp"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="◷  ~ 8h" android:textColor="#153A68" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="13dp" android:orientation="horizontal" android:gravity="start">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="7dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_roteiros_tag" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="Cultura" android:textColor="#153A68" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="7dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_roteiros_tag" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="Histórico" android:textColor="#153A68" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="7dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_roteiros_tag" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="Gastronomia" android:textColor="#153A68" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/btnDetalhes" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="Ver detalhes  →"
            android:textColor="#0874E9" android:textStyle="bold" android:textSize="18sp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>